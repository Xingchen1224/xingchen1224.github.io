---
import Icon from './Icon.astro';
import { SITE, SOCIAL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__copyright">&copy; {year} {SITE.name}. Built with <a href="https://astro.build" rel="noopener">Astro</a>.</p>
    <div class="social-icons">
      <a href={SOCIAL.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" /></a>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a>
    </div>
  </div>
</footer>
