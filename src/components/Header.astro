---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import avatar from '../assets/bio-photo.jpg';
import { NAV, SITE, SOCIAL } from '../consts';

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label={`${SITE.name} — home`}>
      <Image
        class="site-brand__avatar"
        src={avatar}
        alt=""
        width={30}
        height={30}
        densities={[1, 2]}
        loading="eager"
      />
      <span class="site-brand__name">{SITE.name}</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Primary">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.title}
        </a>
      ))}
    </nav>

    <a class="icon-btn header-link" href={SOCIAL.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
      <Icon name="linkedin" />
    </a>

    <!-- Both states are always visible; the thumb shows which one is on. -->
    <button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Dark mode" data-theme-toggle>
      <span class="theme-switch__thumb" aria-hidden="true"></span>
      <Icon name="sun" class="theme-switch__icon" />
      <Icon name="moon" class="theme-switch__icon" />
    </button>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >&#9776;</button>
  </div>
</header>
