---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import avatar from '../assets/bio-photo.jpg';
import { ACCENTS, NAV, SITE } from '../consts';

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label={`${SITE.name} — home`}>
      <Image
        class="site-brand__avatar"
        src={avatar}
        alt=""
        width={30}
        height={30}
        densities={[1, 2]}
        loading="eager"
      />
      <span class="site-brand__name">{SITE.name}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >&#9776;</button>

    <nav class="site-nav" id="site-nav" aria-label="Primary">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.title}
        </a>
      ))}
    </nav>

    <!-- Laid out flat in the bar rather than behind a menu: two clicks became one. -->
    <div class="xw-settings" data-settings>
      <div class="xw-seg" data-role="theme" data-active="dark" role="group" aria-label="Appearance">
        <button type="button" data-val="light" aria-pressed="false" aria-label="Light theme" title="Light"><Icon name="sun" /></button>
        <button type="button" data-val="dark" aria-pressed="false" aria-label="Dark theme" title="Dark"><Icon name="moon" /></button>
      </div>
      <div class="xw-swatches" data-role="accent" role="group" aria-label="Accent colour">
        {ACCENTS.map((a) => (
          <button
            type="button"
            class="xw-swatch"
            data-val={a.id}
            style={`background:${a.hex}`}
            aria-label={`${a.name} accent`}
            title={a.name}
            aria-pressed="false"
          ></button>
        ))}
      </div>
    </div>
  </div>
</header>
