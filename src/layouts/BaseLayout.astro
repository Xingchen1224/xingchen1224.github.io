---
// Self-hosted variable fonts. Each stylesheet declares per-subset @font-face
// rules with a unicode-range, so a latin-only page downloads exactly one file
// per family — and none of it costs a third-party connection.
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import avatarSource from '../assets/bio-photo.jpg';
import { SITE, SOCIAL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  type = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE.title}` : SITE.title;
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);

// Derived rather than `avatarSource.src`: referencing the raw import would ship
// the untouched 364 kB original into the build just to name it in JSON-LD.
const avatar = await getImage({ src: avatarSource, width: 400, height: 400, format: 'webp' });

// schema.org: every page identifies the author; article pages also describe
// themselves as a BlogPosting so search results can show byline and date.
const person = {
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: SITE.author.name,
  url: SITE.url,
  image: new URL(avatar.src, site).href,
  jobTitle: SITE.author.bio,
  sameAs: [SOCIAL.github, SOCIAL.linkedin],
};

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage.href,
        datePublished: publishedTime?.toISOString(),
        mainEntityOfPage: canonical.href,
        author: person,
        publisher: person,
      }
    : { '@context': 'https://schema.org', ...person };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta property="og:image:width" content={String(SITE.ogImageSize.width)} />
    <meta property="og:image:height" content={String(SITE.ogImageSize.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <!-- Set theme early to avoid a flash of the wrong palette -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('xw-theme') ||
            (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          var a = localStorage.getItem('xw-accent') || 'cyan';
          var r = document.documentElement;
          r.setAttribute('data-theme', t);
          r.setAttribute('data-accent', a);
        } catch (e) {}
      })();
    </script>

  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initTheme } from '../scripts/theme';
      import { initReveal } from '../scripts/reveal';
      import { initNav } from '../scripts/nav';
      initTheme();
      initReveal();
      initNav();
    </script>
  </body>
</html>
