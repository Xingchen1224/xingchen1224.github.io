---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="Page not found. Your pixels are in another canvas.">
  <div class="wrap wrap--narrow" style="padding:5rem 1.25rem; text-align:center;">
    <p class="section__eyebrow">Error 404</p>
    <h1 style="font-size:clamp(2.4rem,7vw,4rem); margin:0.5rem 0 1rem;">
      <span class="xw-grad">Page not found</span>
    </h1>
    <p style="color:var(--ink-soft); max-width:48ch; margin:0 auto 2rem;">
      Sorry, the page you were trying to view does not exist. Your pixels are in another canvas.
    </p>
    <a class="btn btn--primary" href="/">Back to home</a>
  </div>
</BaseLayout>
