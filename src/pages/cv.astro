---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
import avatar from '../assets/bio-photo.jpg';
import { PRINCIPLES, SITE, SOCIAL } from '../consts';

const skills: { icon: IconName; title: string; tags: string[] }[] = [
  {
    icon: 'eye',
    title: 'Image & Vision',
    tags: ['Image Algorithms', 'Image Processing', 'Computer Vision', 'Computational Imaging', 'OpenCV'],
  },
  {
    icon: 'terminal',
    title: 'Languages & Tooling',
    tags: ['C++', 'Python', 'Shell', 'CMake', 'Git'],
  },
  {
    icon: 'cubes',
    title: 'Frameworks & Domains',
    tags: ['JUCE', 'Cross-platform C++', 'Build Systems'],
  },
  {
    icon: 'sitemap',
    title: 'Leadership',
    tags: ['Project Leadership', 'R&D Planning', 'Code Review', 'System Design'],
  },
];

const focus = [
  ['Computational imaging', '& image-quality algorithms'],
  ['Computer vision', '& visual perception systems'],
  ['Image pipeline architecture', '(RAW, ISP, post-processing)'],
  ['Algorithm-to-production', 'engineering & tooling'],
  ['Technical leadership', '& cross-functional teams'],
  ['System design', '& engineering quality'],
];
---

<BaseLayout title="CV" description="Xingchen Wang — Image Algorithms R&D · Technical Project Leader">
  <div class="wrap wrap--mid page-top">
    <header class="cv-head">
      <Image
        class="cv-head__avatar"
        src={avatar}
        alt={SITE.author.name}
        width={96}
        height={96}
        densities={[1, 2]}
        loading="eager"
      />
      <div>
        <h1 class="cv-head__name">{SITE.name}</h1>
        <p class="cv-head__role">Image Algorithms R&amp;D <span aria-hidden="true">/</span> Technical Project Leader</p>
        <div class="cv-head__links">
          <a href={SOCIAL.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
          <span><Icon name="microchip" />Computer Vision</span>
          <span><Icon name="code" />C++ / Python</span>
        </div>
      </div>
    </header>

    <section class="split" data-reveal>
      <h2 class="split__label">Summary</h2>
      <div>
        <p class="cv-lead">
          Image algorithms R&amp;D engineer and technical project leader working across image
          processing, computer vision and computational imaging.
        </p>
        <p class="cv-body">
          I focus on taking algorithms from prototype to production-quality software, and on leading
          the engineering work that turns research into reliable systems — designing imaging
          pipelines, directing R&amp;D initiatives and helping teams ship high-quality visual products
          at scale.
        </p>
      </div>
    </section>

    <section class="split" data-reveal>
      <h2 class="split__label">How I work</h2>
      <dl class="cv-skills">
        {PRINCIPLES.map((p) => (
          <div class="cv-skill">
            <dt>{p.title}</dt>
            <dd class="cv-body">{p.long}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="split" data-reveal>
      <h2 class="split__label">Skills</h2>
      <dl class="cv-skills">
        {skills.map((s) => (
          <div class="cv-skill">
            <dt><Icon name={s.icon} />{s.title}</dt>
            <dd class="tags">{s.tags.map((t) => <span class="tag">{t}</span>)}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="split" data-reveal>
      <h2 class="split__label">Focus</h2>
      <ul class="cv-focus">
        {focus.map(([bold, rest]) => (
          <li><b>{bold}</b>{rest}</li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
