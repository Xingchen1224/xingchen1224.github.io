---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import avatar from '../assets/bio-photo.jpg';
import { PRINCIPLES, SITE, SOCIAL } from '../consts';
import { CV, CV_HTML_PATH, CV_PDF_PATH } from '../lib/cv';
---

<BaseLayout title="CV" description="Xingchen Wang — Image Algorithms R&D · Technical Project Leader">
  <div class="wrap wrap--mid page-top">
    <header class="cv-head">
      <Image
        class="cv-head__avatar"
        src={avatar}
        alt={SITE.author.name}
        width={72}
        height={72}
        densities={[1, 2]}
        loading="eager"
      />
      <div>
        <h1 class="cv-head__name">{SITE.name}</h1>
        <p class="cv-head__role">Image Algorithms R&amp;D <span aria-hidden="true">/</span> Technical Project Leader</p>
        <div class="cv-head__actions">
          <a class="cv-head__link" href={SOCIAL.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
          <a class="cv-head__link" href="#" data-email><Icon name="envelope" /><span data-email-text>Email</span></a>
          <a class="cv-head__link" href={CV_PDF_PATH} download="xingchen-wang-cv.pdf"><Icon name="download" />PDF</a>
          <a class="cv-head__link" href={CV_HTML_PATH} download="xingchen-wang-cv.html"><Icon name="download" />HTML</a>
        </div>
      </div>
      <p class="print-only cv-head__urls">{SITE.url.replace('https://', '')} · {SOCIAL.linkedin.replace('https://www.', '')} · <span data-email-text></span></p>
    </header>

    <section class="split">
      <h2 class="split__label">Summary</h2>
      <div>
        <p class="cv-lead">{CV.now}</p>
        <p class="cv-before"><span>Before</span>{CV.before}</p>
      </div>
    </section>

    <section class="split">
      <h2 class="split__label">Skills</h2>
      <dl class="kv">
        {CV.skills.map((r) => (
          <div class:list={['quiet' in r && 'is-quiet']}><dt>{r.title}</dt><dd>{r.body}</dd></div>
        ))}
      </dl>
    </section>

    <section class="split" id="open-source">
      <h2 class="split__label">Open source</h2>
      <dl class="kv">
        {CV.openSource.map((r) => (
          <div><dt><a href={r.href} target="_blank" rel="noopener">{r.title}</a></dt><dd>{r.body}</dd></div>
        ))}
      </dl>
    </section>

    <section class="split">
      <h2 class="split__label">Philosophies</h2>
      <dl class="kv">
        {PRINCIPLES.map((p) => (
          <div><dt>{p.title}</dt><dd>{p.short}</dd></div>
        ))}
      </dl>
    </section>

    <section class="split">
      <h2 class="split__label">Interests</h2>
      <dl class="kv">
        {CV.interests.map((r) => (
          <div><dt>{r.title}</dt><dd>{r.body}</dd></div>
        ))}
      </dl>
    </section>
  </div>
</BaseLayout>

<script>
  // The address is assembled here, not written into the HTML (see consts.ts).
  import { emailAddress } from '../consts';
  const addr = emailAddress();
  document.querySelectorAll<HTMLAnchorElement>('[data-email]').forEach((a) => (a.href = `mailto:${addr}`));
  document.querySelectorAll<HTMLElement>('[data-email-text]').forEach((el) => (el.textContent = addr));
</script>
