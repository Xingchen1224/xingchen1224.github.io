---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL } from '../consts';

const skills = [
  {
    icon: 'fas fa-eye',
    title: 'Image & Vision',
    tags: ['Image Algorithms', 'Image Processing', 'Computer Vision', 'Computational Imaging', 'OpenCV'],
  },
  {
    icon: 'fas fa-terminal',
    title: 'Languages & Tooling',
    tags: ['C++', 'Python', 'Shell', 'CMake', 'Git'],
  },
  {
    icon: 'fas fa-cubes',
    title: 'Frameworks & Domains',
    tags: ['JUCE', 'Cross-platform C++', 'Build Systems'],
  },
  {
    icon: 'fas fa-sitemap',
    title: 'Leadership',
    tags: ['Project Leadership', 'R&D Planning', 'Code Review', 'System Design'],
  },
];

const focus = [
  ['Computational imaging', '& image-quality algorithms'],
  ['Computer vision', '& visual perception systems'],
  ['Image pipeline architecture', '(RAW, ISP, post-processing)'],
  ['Algorithm-to-production', 'engineering & tooling'],
  ['Technical leadership', '& cross-functional teams'],
  ['System design', '& engineering quality'],
];
---

<BaseLayout title="Curriculum Vitae" description="Image Algorithms R&D · Technical Project Leader">
  <div class="cv">
    <section class="cv-hero" data-reveal>
      <div class="cv-hero__bar">
        <span class="cv-hero__dot cv-hero__dot--r"></span>
        <span class="cv-hero__dot cv-hero__dot--y"></span>
        <span class="cv-hero__dot cv-hero__dot--g"></span>
        <span class="cv-hero__file">xingchen_wang — curriculum_vitae</span>
      </div>
      <div class="cv-hero__body">
        <div class="cv-hero__prompt"><span class="cv-cmd">$</span> whoami --profile</div>
        <h1 class="cv-hero__name">Xingchen Wang</h1>
        <p class="cv-hero__role">
          Image Algorithms R&amp;D <span class="cv-sep">/</span> Technical Project Leader
        </p>
        <div class="cv-hero__meta">
          <span><i class="fas fa-microchip"></i>Computer Vision</span>
          <span><i class="fas fa-code"></i>C++ / Python</span>
          <span><i class="fas fa-globe"></i>Global</span>
        </div>
        <div class="cv-actions">
          <a class="cv-btn cv-btn--solid" href={SOCIAL.github} target="_blank" rel="noopener">
            <i class="fab fa-github"></i>GitHub
          </a>
          <a class="cv-btn cv-btn--ghost" href={SOCIAL.linkedin} target="_blank" rel="noopener">
            <i class="fab fa-linkedin"></i>LinkedIn
          </a>
        </div>
      </div>
    </section>

    <section class="cv-section" data-reveal>
      <div class="cv-section__head">
        <span class="cv-section__idx">01</span>
        <h2 class="cv-section__title">Summary</h2>
        <span class="cv-section__rule"></span>
      </div>
      <p class="cv-lead">
        Image Algorithms R&amp;D engineer and Technical Project Leader working across image processing,
        computer vision, and computational imaging. I focus on taking algorithms from prototype to
        production-quality software, and on leading the engineering work that turns research into
        reliable systems.
      </p>
    </section>

    <section class="cv-section" data-reveal>
      <div class="cv-section__head">
        <span class="cv-section__idx">02</span>
        <h2 class="cv-section__title">Technical Skills</h2>
        <span class="cv-section__rule"></span>
      </div>
      <div class="cv-skills">
        {skills.map((s) => (
          <div class="cv-skill">
            <div class="cv-skill__title"><i class={s.icon}></i>{s.title}</div>
            <div class="cv-tags">
              {s.tags.map((t) => <span class="cv-tag">{t}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="cv-section" data-reveal>
      <div class="cv-section__head">
        <span class="cv-section__idx">03</span>
        <h2 class="cv-section__title">Areas of Focus</h2>
        <span class="cv-section__rule"></span>
      </div>
      <div class="cv-focus">
        {focus.map(([bold, rest]) => (
          <div class="cv-focus__item">
            <i class="fas fa-chevron-right"></i><span><b>{bold}</b> {rest}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="cv-section" data-reveal>
      <div class="cv-section__head">
        <span class="cv-section__idx">04</span>
        <h2 class="cv-section__title">Contact</h2>
        <span class="cv-section__rule"></span>
      </div>
      <div class="cv-contact">
        <a href={SOCIAL.github} target="_blank" rel="noopener"><i class="fab fa-github"></i>github.com/Xingchen1224</a>
        <a href={SOCIAL.linkedin} target="_blank" rel="noopener"><i class="fab fa-linkedin"></i>linkedin.com/in/xingchen-wang</a>
      </div>
    </section>
  </div>
</BaseLayout>
