---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import avatar from '../assets/bio-photo.jpg';
import { PRINCIPLES, SITE } from '../consts';
import { CV } from '../lib/cv';
import { getSortedPosts, formatDate, postUrl } from '../lib/posts';

const merged = CV.openSource.reduce((n, p) => n + p.merged, 0);
const posts = (await getSortedPosts()).slice(0, 3);
---

<BaseLayout>
  <div class="home wrap">
    <section class="home__hero">
      <div class="home__copy">
        <p class="hero__kicker"><span class="dot" aria-hidden="true"></span><span class="hero__role">{SITE.author.bio}</span></p>
        <h1 class="hero__title">Stay hungry,<br />stay <em>foolish</em>.</h1>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/cv/">View CV<span class="btn__arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="/posts/">Read Log<span class="btn__arrow" aria-hidden="true">→</span></a>
        </div>
        <section class="hero__log">
          <div class="block__head">
            <h2 class="split__label"><a href="/posts/">Latest log →</a></h2>
          </div>
          <ul class="rows">
            {posts.map((post) => (
              <li>
                <a href={postUrl(post)}>
                  <span class="rows__name">{post.data.title}</span>
                  <time class="rows__meta" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
      <figure class="hero__portrait" data-pixelate>
        <Image
          class="hero__photo"
          src={avatar}
          alt={`Portrait of ${SITE.name}`}
          width={360}
          height={360}
          densities={[1, 2]}
          loading="eager"
        />
      </figure>
      <section class="hero__oss">
        <div class="block__head">
          <h2 class="split__label"><a href="/cv/#open-source">Open source →</a></h2>
          <p class="oss__stat"><b>{merged}</b> merged PRs</p>
        </div>
        <ul class="rows">
          {CV.openSource.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener" aria-label={`${p.title}: ${p.merged} merged PR${p.merged > 1 ? 's' : ''}`}>
                <span class="rows__name">{p.title}</span>
                <span class="rows__meta" aria-hidden="true">{p.merged} {p.merged > 1 ? 'PRs' : 'PR'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </section>

    <div class="home__band">
      <section>
        <h2 class="split__label">Philosophies</h2>
        <ol class="mini">
          {PRINCIPLES.map((p, i) => (
            <li><span class="mini__n">0{i + 1}</span><b>{p.title}</b><span>{p.short}</span></li>
          ))}
        </ol>
      </section>
    </div>
  </div>
</BaseLayout>
