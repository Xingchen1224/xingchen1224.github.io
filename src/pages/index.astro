---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import avatar from '../assets/bio-photo.jpg';
import { getSortedPosts, formatDate, postUrl } from '../lib/posts';
import { PRINCIPLES, SITE, SOCIAL } from '../consts';

const posts = (await getSortedPosts()).slice(0, 3);
---

<BaseLayout>
  <div class="home wrap">
    <section class="home__hero">
      <div class="home__copy">
        <p class="hero__kicker"><span class="dot"></span><strong>{SITE.name}</strong><span class="hero__role">Image Algorithms R&amp;D / Technical Project Leader</span></p>
        <h1 class="hero__title">Stay hungry,<br />stay <em>foolish</em>.</h1>
        <blockquote class="hero__quote">Everything should be as simple as possible, but not simpler.</blockquote>
        <p class="hero__tagline">
          I build production software together with AI — it brings the speed, I keep the
          direction. Image algorithms R&amp;D and technical leadership by trade.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/cv/">View CV</a>
          <a class="arrow-link" href="/posts/">Read my writing →</a>
        </div>
      </div>
      <figure class="hero__portrait" data-pixelate>
        <Image
          class="hero__photo"
          src={avatar}
          alt={`Portrait of ${SITE.name}`}
          width={220}
          height={220}
          densities={[1, 2]}
          loading="eager"
        />
      </figure>
    </section>

    <div class="home__band">
      <section>
        <h2 class="split__label">How I work</h2>
        <ul class="mini">
          {PRINCIPLES.map((p) => <li><b>{p.title}</b><span>{p.short}</span></li>)}
        </ul>
      </section>

      <section>
        <h2 class="split__label"><a href="/posts/">Writing →</a></h2>
        <ul class="mini">
          {posts.map((post) => (
            <li>
              <a href={postUrl(post)}><b>{post.data.title}</b></a>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="split__label">Elsewhere</h2>
        <ul class="mini mini--links">
          <li><a href={SOCIAL.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a></li>
          <li><a href="/cv/"><Icon name="chevron-right" />Curriculum vitae</a></li>
          <li><a href="/rss.xml"><Icon name="chevron-right" />RSS feed</a></li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
