---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getSortedPosts, formatDate, postSlug, postUrl } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      prev: posts[i + 1] ?? null,
      next: posts[i - 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt ?? post.data.title}
  type="article"
  publishedTime={post.data.date}
>
  <article class="article">
    <div class={post.data.wide ? 'wrap' : 'wrap wrap--narrow'}>
      <a class="back-link" href="/posts/"><Icon name="arrow-left" /> All posts</a>
      <header class="article__header">
        <div class="article__meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'long')}</time>
          {post.data.categories.map((c) => <span>{c}</span>)}
        </div>
        <h1 class="article__title">{post.data.title}</h1>
        {post.data.tags.length > 0 && (
          <div class="article__tags">
            {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
          </div>
        )}
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="article__nav">
        {prev ? <a href={postUrl(prev)}>&larr; {prev.data.title}</a> : <span></span>}
        {next ? <a href={postUrl(next)}>{next.data.title} &rarr;</a> : <span></span>}
      </nav>
    </div>
  </article>
</BaseLayout>
