---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedPosts, formatDate, postUrl } from '../../lib/posts';

const posts = await getSortedPosts();
---

<BaseLayout title="Posts" description="Writing on image algorithms, computer vision, and engineering.">
  <div class="wrap wrap--narrow page-top">
    <!-- The listing speaks for itself; the heading stays for document structure. -->
    <h1 class="sr-only">Posts</h1>

    {posts.length === 0 ? (
      <p>No posts yet — check back soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-list__item" data-reveal>
            <div class="post-list__meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              {post.data.categories.map((c) => <span class="tag">{c}</span>)}
            </div>
            <h2 class="post-list__title"><a href={postUrl(post)}>{post.data.title}</a></h2>
            {post.data.excerpt && <p class="post-list__excerpt">{post.data.excerpt}</p>}
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
